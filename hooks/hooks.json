{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/compass.py\" hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/lean.py\" hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/queue.py\" hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/daily.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/lean.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/lean.py\" hook",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/queue.py\" hook",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/daily.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Read$",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/read.py\" hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
