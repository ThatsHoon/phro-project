{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/compass.py\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
